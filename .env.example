# Core
DEBUG=True
# Production should use a unique key with at least 50 random characters.
SECRET_KEY=replace-with-a-long-random-value-at-least-50-characters

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Keep False for local HTTP. These values override the DEBUG-based defaults.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
BASE_URL=http://localhost:8000
# Optional absolute path for durable uploaded media (for example, a mounted disk).
# MEDIA_ROOT=C:\CertDesk\media
TIME_ZONE=America/New_York

# Database: SQLite is used when DATABASE_URL is empty.
DATABASE_URL=
# DATABASE_URL=postgresql://certdesk:password@localhost:5432/certdesk

# Email (console output by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=CertDesk <hello@example.com>

# Stripe (optional in demo mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=

# Public demo. Set False on a production deployment.
DEMO_MODE=True

# Optional Growth-plan document metadata extraction endpoint (OpenAI-compatible).
# AI_BASE_URL may be the API root (for example https://api.openai.com/v1)
# or a full .../chat/completions URL. Use HTTPS outside local development.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
